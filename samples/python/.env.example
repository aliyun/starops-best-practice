# STAROps SDK environment configuration. Copy to .env and fill in your values.

# API endpoint, e.g. starops.cn-beijing.aliyuncs.com / starops.ap-southeast-1.aliyuncs.com
STAROPS_ENDPOINT=starops.cn-beijing.aliyuncs.com
STAROPS_WORKSPACE=your-workspace-id

# Credentials: recommended `aliyun configure` (CLI profile ~/.aliyun/config.json) or
# shell env vars. AK/SK below is supported but risks leaking via git.
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

STAROPS_REGION=cn-beijing
STAROPS_EMPLOYEE_NAME=apsara-ops

STAROPS_MAX_RETRIES=10
# Seconds with no message before the stream is treated as interrupted.
STAROPS_IDLE_TIMEOUT=60

STAROPS_LOG_LEVEL=info
